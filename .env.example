# ============================================================
# PhytoVisionAI_Research — Environment Configuration
# Copy to .env and fill in real values. Never commit real secrets.
# ============================================================

# --- Backend ---
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000

# --- MongoDB (used ONLY as a cache for external scientific data) ---
MONGODB_URI=mongodb://127.0.0.1:27017/phyto_vision_cache

# --- AI Service ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173

# --- JWT / Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Scientific API keys (fill as available) ---
# GBIF is public; no key strictly required.
GBIF_API_URL=https://api.gbif.org/v1
# PubChem is public; no key strictly required.
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
# Europe PMC is public; no key strictly required.
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
# Crossref is public; no key strictly required.
CROSSREF_API_URL=https://api.crossref.org/works

# --- Cache TTLs (milliseconds) ---
CACHE_TTL_MS=86400000

# --- Dataset / Training ---
DATASET_RAW_DIR=dataset/raw
DATASET_CLEANED_DIR=dataset/cleaned
DATASET_TRAIN_DIR=dataset/train
DATASET_VALIDATION_DIR=dataset/validation
DATASET_TEST_DIR=dataset/test
RANDOM_SEED=42
