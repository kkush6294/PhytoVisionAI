# ============================================================
# PhytoVisionAI_Research — Environment Configuration
# Copy to .env and fill in real values. Never commit real secrets.
# ============================================================

# --- Backend ---
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000

# --- MongoDB (used ONLY as a cache for external scientific data) ---
MONGODB_URI=mongodb://127.0.0.1:27017/phyto_vision_cache

# --- AI Service ---
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173

# --- JWT / Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Scientific API keys (fill as available) ---
# GBIF is public; no key strictly required.
GBIF_API_URL=https://api.gbif.org/v1
# PubChem is public; no key strictly required.
PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
# Europe PMC is public; no key strictly required.
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
# Crossref is public; no key strictly required.
CROSSREF_API_URL=https://api.crossref.org/works

# --- Cache TTLs (milliseconds) ---
CACHE_TTL_MS=86400000

# --- Geolocation / Reverse Geocoding (Phase 4) ---
# OpenStreetMap Nominatim Usage Policy requires a valid identifying User-Agent with contact info (email or repository URL).
# Note: Nominatim blocks fake domains like '@example.com'. Use your real contact email or repository URL.
# Example: NOMINATIM_CONTACT=https://github.com/kkush6294/PhytoVisionAI
# This value is used strictly server-side in backend HTTP headers and is NEVER exposed to the frontend.
NOMINATIM_CONTACT=https://github.com/your-username/PhytoVisionAI

# --- Weather / Environmental Context (Phase 5) ---
# OpenWeatherMap API key (used server-side only to fetch coarse weather conditions).
# Obtain a key from: https://openweathermap.org/api
# This key is used strictly server-side and is NEVER exposed to the frontend.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# --- Evidence-Grounded AI / LLM (Final Phase) ---
# Supported providers: gemini, openai, or custom HTTPS endpoint.
# The AI service is optional and non-blocking: if unconfigured, structured botanical and chemical cards remain fully functional.
# LLM credentials are used strictly server-side and NEVER exposed to frontend or client responses.
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
# LLM_ENDPOINT is strictly optional and must be a safe, non-private HTTPS endpoint
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/...

# --- Dataset / Training ---
DATASET_RAW_DIR=dataset/raw
DATASET_CLEANED_DIR=dataset/cleaned
DATASET_TRAIN_DIR=dataset/train
DATASET_VALIDATION_DIR=dataset/validation
DATASET_TEST_DIR=dataset/test
RANDOM_SEED=42
